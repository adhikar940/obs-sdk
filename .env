# .env
# --- Service Name ---
OTEL_SERVICE_NAME="test-auto-instrument-app"

# --- Protocol: "http" (default) or "grpc" ---
OTEL_EXPORTER_OTLP_PROTOCOL="http"

# --- Langfuse ---
LANGFUSE_EXPORT=false
LANGFUSE_ENDPOINT="http://localhost:3000/api/public/otel"  # or http://localhost:4318, or https://<your-region>.langfuse.com/api/public/otel
LANGFUSE_API_KEY=""                                        # Optional for local, required for remote/cloud
LANGFUSE_PROTOCOL="http"                                   # "http" (default) or "grpc"

# --- Arize Phoenix ---
ARIZE_EXPORT=true
ARIZE_ENDPOINT="http://localhost:6006/v1/traces"  # HTTP: http://localhost:6006/v1/traces, gRPC: http://localhost:14317
ARIZE_PROTOCOL="http"                            # "http" (default) or "grpc"
ARIZE_API_KEY=""                                 # Optional for Arize Cloud or protected Phoenix
ARIZE_PROJECT_NAME="default"                     # Optional project name

# --- Console ---
CONSOLE_EXPORT=true

# --- Auto-Instrumentation ---
AUTO_INSTRUMENT=true
AUTO_INSTRUMENTATIONS="requests,httpx,urllib,urllib3,aiohttp,postgres,psycopg2,redis,dbapi"