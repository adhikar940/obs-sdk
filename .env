# .env
# --- Service Name ---
OTEL_SERVICE_NAME="test-auto-instrument-app"

# --- Local Langfuse ---
LOCAL_LANGfUSE_EXPORT=true
LOCAL_LANGfUSE_ENDPOINT="http://localhost:4317"
LOCAL_LANGfUSE_API_KEY="your-local-api-key"  # Optional if local Langfuse doesn't require auth

# --- Remote Langfuse ---
REMOTE_LANGfUSE_EXPORT=true
REMOTE_LANGfUSE_ENDPOINT="https://<your-region>.langfuse.com/otlp"
REMOTE_LANGfUSE_API_KEY="your-remote-api-key"

# --- Console ---
CONSOLE_EXPORT=true