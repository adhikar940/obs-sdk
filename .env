# .env
# --- Service Name ---
OTEL_SERVICE_NAME="test-auto-instrument-app"

# --- Protocol: "http" (default) or "grpc" ---
OTEL_EXPORTER_OTLP_PROTOCOL="http"

# --- Local Langfuse ---
LOCAL_LANGFUSE_EXPORT=false
LOCAL_LANGFUSE_ENDPOINT="http://localhost:4318"  # HTTP: http://localhost:4318, gRPC: http://localhost:4317
LOCAL_LANGFUSE_API_KEY="your-local-api-key"      # Optional if local Langfuse doesn't require auth
LOCAL_LANGFUSE_PROTOCOL="http"                  # Optional: override global protocol

# --- Remote Langfuse ---
REMOTE_LANGFUSE_EXPORT=false
REMOTE_LANGFUSE_ENDPOINT="https://<your-region>.langfuse.com/api/public/otel"
REMOTE_LANGFUSE_API_KEY="your-remote-api-key"
REMOTE_LANGFUSE_PROTOCOL="http"

# --- Arize Phoenix ---
ARIZE_EXPORT=true
ARIZE_ENDPOINT="http://localhost:6006/v1/traces"  # HTTP: http://localhost:6006/v1/traces, gRPC: http://localhost:14317
ARIZE_PROTOCOL="http"                            # "http" (default) or "grpc"
ARIZE_API_KEY=""                                 # Optional for Arize Cloud or protected Phoenix
ARIZE_PROJECT_NAME="default"                     # Optional project name

# --- Console ---
CONSOLE_EXPORT=true

# --- Auto-Instrumentation ---
AUTO_INSTRUMENT=true
AUTO_INSTRUMENTATIONS="requests,psycopg2,redis,dbapi"